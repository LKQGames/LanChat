<Window x:Class="LanChat.UsernameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置用户名" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="28" Padding="28"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="HeaderBar" Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource PrimaryContainerBrush}"
                        Margin="0,0,14,0" DockPanel.Dock="Left">
                    <TextBlock Text="☺" Foreground="{StaticResource OnPrimaryContainerBrush}" FontSize="21"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="你的用户名" Style="{StaticResource TitleLarge}" FontSize="20" />
                    <TextBlock Text="选择一个在聊天室中显示的名称" Style="{StaticResource BodySmall}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBox x:Name="UsernameInput" Grid.Row="1" Margin="0,26,0,8" MaxLength="32" VerticalContentAlignment="Center" />
            <TextBlock x:Name="ValidationText" Grid.Row="2" Text="最多 32 个字符" Style="{StaticResource BodySmall}" Margin="4,0,0,0" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource TextButton}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="确定" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
