<Window x:Class="LanChat.ConnectionClosedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室连接已关闭" Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI"
        Loaded="Window_Loaded">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="28" Padding="28"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="连接已关闭" Style="{StaticResource TitleLarge}" FontSize="19" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="主机已关闭连接" Style="{StaticResource TitleMedium}" FontSize="16" />
                <TextBlock x:Name="CountdownText" Text="窗口将在 5 秒后自动关闭。" Style="{StaticResource BodySmall}" Margin="0,10,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Content="确定" HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" />
        </Grid>
    </Border>
</Window>
