<Window x:Class="LanChat.LoggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序运行日志" Width="820" Height="520" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI"
        Closed="Window_Closed">
    <Grid Background="{StaticResource SurfaceBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,16">
            <StackPanel>
                <TextBlock Text="程序运行日志" Style="{StaticResource HeadlineSmall}" FontSize="22" />
                <TextBlock Text="实时记录当前程序的房间和连接活动" Style="{StaticResource BodySmall}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="保存日志" Click="SaveLog_Click" Style="{StaticResource TonalButton}" Padding="16,9" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="20" Padding="10">
            <ListBox x:Name="EntriesList" Background="Transparent" FontFamily="Consolas, ./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SecondaryContainerBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</Window>
