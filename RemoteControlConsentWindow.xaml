<Window x:Class="LanChat.RemoteControlConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程控制申请" Width="500" SizeToContent="Height" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI"
        ResizeMode="NoResize">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="24" Padding="26" Margin="10"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="远程控制申请" Style="{StaticResource TitleLarge}" FontSize="20" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18">
                <TextBlock x:Name="RequesterText" Style="{StaticResource TitleMedium}" FontSize="16" />
                <Border Background="{StaticResource SurfaceContainerBrush}" CornerRadius="14" Padding="14" Margin="0,14,0,0">
                    <TextBlock Text="希望通过 RustDesk 查看并控制此计算机的屏幕、鼠标和键盘。接受后 LanChat 会自动开启 RustDesk 的“直接 IP 访问”（TCP 21118）并启动 RustDesk；屏幕采集、键鼠操作和会话本身由 RustDesk 原生客户端处理。首次被控时 Windows 可能询问防火墙权限，请允许；若对方需要密码，请把 RustDesk 主窗口显示的临时密码告诉对方。该直连模式未加密；仅在可信网络接受请求，控制期间可随时在聊天室结束。"
                               Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="拒绝" Style="{StaticResource TextButton}" Click="Decline_Click" Margin="0,0,10,0" />
                <Button Content="接受并开始" Click="Accept_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
