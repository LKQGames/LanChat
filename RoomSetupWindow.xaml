<Window x:Class="LanChat.RoomSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建聊天室" Width="452" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="28" Padding="30"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="新建聊天室" Style="{StaticResource HeadlineSmall}" />
                <TextBlock Text="设置房间信息并启动局域网群聊" Style="{StaticResource BodySmall}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="房间名" Style="{StaticResource LabelMedium}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8" />
                <TextBox x:Name="RoomNameInput" MaxLength="48" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock Text="房间端口（1024–65535）" Style="{StaticResource LabelMedium}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8" />
                <TextBox x:Name="PortInput" Text="47821" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <TextBlock Text="房间密码（可选）" Style="{StaticResource LabelMedium}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8" />
                <PasswordBox x:Name="PasswordInput" />
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,18,0,0">
                <RadioButton x:Name="PublicOption" Content="公开（可被搜索）" GroupName="RoomPrivacy" IsChecked="True" Margin="0,0,20,0" />
                <RadioButton x:Name="PrivateOption" Content="私密（仅手动加入）" GroupName="RoomPrivacy" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" Grid.Row="5" VerticalAlignment="Top" Margin="4,10,0,0" FontSize="12"
                       Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource TextButton}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="创建房间" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
