<Window x:Class="LanChat.RustDeskConnectModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择远程连接方式" Width="540" SizeToContent="Height" MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI"
        ResizeMode="NoResize">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="24" Padding="24" Margin="10"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="选择远程连接方式" Style="{StaticResource TitleLarge}" FontSize="20" />
                <TextBlock x:Name="TargetText" Style="{StaticResource BodySmall}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,14">
                <Border Background="{StaticResource SurfaceContainerBrush}" CornerRadius="14" Padding="14">
                    <StackPanel>
                        <TextBlock Text="同一局域网" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="选“IP 直连”，不经过中转，速度最快。" Style="{StaticResource BodyMedium}" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Text="不在同一网络或跨互联网" Foreground="{StaticResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,0" />
                        <TextBlock Text="选“RustDesk ID 连接”，双方都需要能访问 RustDesk 公共服务器。" Style="{StaticResource BodyMedium}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="IdHintText" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <Button x:Name="DirectIpButton" Content="局域网 IP 直连" Click="DirectIp_Click" Margin="0,0,0,10" />
                <Button x:Name="IdButton" Content="RustDesk ID 连接" Click="Id_Click" Style="{StaticResource TonalButton}" Margin="0,0,0,10" />
                <Button Content="取消本次远控" Click="Cancel_Click" Style="{StaticResource TextButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
