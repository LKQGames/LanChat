<Window x:Class="LanChat.RoomAccessNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="聊天室访问提示" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="28" Padding="28"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="聊天室访问提示" Style="{StaticResource TitleLarge}" FontSize="19" />
            </StackPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,0">
                <TextBlock x:Name="NoticeText" Text="您已被移出聊天室" Style="{StaticResource TitleMedium}" FontSize="17" />
                <TextBlock Text="如需重新加入，请联系房主。" Style="{StaticResource BodySmall}" Margin="0,10,0,0" />
            </StackPanel>
            <Button Grid.Row="2" Content="确定" HorizontalAlignment="Right" Click="Close_Click" IsDefault="True" />
        </Grid>
    </Border>
</Window>
