<Window x:Class="LanChat.JoinRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="加入聊天室" Width="580" Height="600" MinHeight="500" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource OnSurfaceBrush}" FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI">
    <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="28" Padding="28"
            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.5" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="加入聊天室" Style="{StaticResource HeadlineSmall}" />
                    <TextBlock x:Name="DialogSubtitle" Text="输入房间地址，或从局域网发现房间" Style="{StaticResource BodySmall}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,22,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="HostInput" Grid.Column="0" ToolTip="主机 IPv4 地址" VerticalContentAlignment="Center" />
                <TextBox x:Name="PortInput" Grid.Column="1" Text="47821" Margin="10,0,0,0" ToolTip="端口" VerticalContentAlignment="Center" />
                <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Click="SearchButton_Click" Style="{StaticResource TonalButton}"
                        Padding="18,10" Margin="10,0,0,0" />
            </Grid>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="发现的聊天室" Style="{StaticResource LabelMedium}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8" />
                <Border Grid.Row="1" Background="{StaticResource SurfaceContainerBrush}" CornerRadius="14" Padding="6">
                    <ListBox x:Name="RoomsList" Background="Transparent" SelectionChanged="RoomsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Width="230" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LockLabel}" Foreground="{StaticResource PrimaryBrush}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="房间名（手动加入时可留空）" Style="{StaticResource LabelMedium}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8" />
                    <TextBox x:Name="RoomNameInput" VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="房间密码（如有）" Style="{StaticResource LabelMedium}" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8" />
                    <PasswordBox x:Name="PasswordInput" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="4,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Style="{StaticResource TextButton}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="加入聊天室" Click="Join_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
