<Window x:Class="LanChat.ChatRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanChat"
        Title="聊天室" Width="1060" Height="780" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource OnSurfaceBrush}"
        FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI"
        Closing="Window_Closing" AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部应用栏 ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceContainerLowBrush}" Padding="20,14">
            <DockPanel>
                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource PrimaryContainerBrush}" Margin="0,0,14,0" DockPanel.Dock="Left">
                    <TextBlock Text="#" FontSize="20" Foreground="{StaticResource OnPrimaryContainerBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="RoomTitle" Style="{StaticResource TitleLarge}" FontSize="19" />
                    <TextBlock x:Name="RoomSubtitle" Style="{StaticResource BodySmall}" Margin="0,2,0,0" />
                    <StackPanel x:Name="RemoteControlStatusPanel" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="RemoteControlStatusText" Text="远程控制进行中" Foreground="#B9D0FF" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="立即结束" Click="StopRemoteControlFromChat_Click" Style="{StaticResource TextButton}" Padding="10,4" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SecondaryContainerBrush}" CornerRadius="10" Padding="12,7" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="房主 · 局域网" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnSecondaryContainerBrush}" VerticalAlignment="Center" />
                    </Border>
                    <ToggleButton Content="置顶" Checked="Pin_Checked" Unchecked="Pin_Unchecked" ToolTip="让窗口保持在其他窗口上方" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 消息区 ===== -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="MemberColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="24" Padding="16" Margin="0,0,10,0">
                <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="MessagesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Border x:Name="Bubble" Background="{StaticResource SurfaceContainerHighBrush}" CornerRadius="18"
                                            Padding="14,11" HorizontalAlignment="Left" MaxWidth="700">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="复制消息" Click="CopyMessage_Click"/>
                                                <MenuItem Header="回复消息" Click="ReplyMessage_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,5">
                                                <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{StaticResource PrimaryBrush}" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding Time}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                           DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border x:Name="QuoteBlock" Visibility="{Binding QuoteVisibility}" Background="{StaticResource SurfaceContainerBrush}"
                                                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="3,0,0,0" CornerRadius="6"
                                                    Padding="10,7" Margin="0,0,0,8" Cursor="Hand" ToolTip="点击跳转到被引用的消息"
                                                    MouseLeftButtonUp="Quote_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding QuoteSender}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding QuoteText}" FontSize="12" Foreground="{StaticResource OnSurfaceVariantBrush}"
                                                               TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <local:MentionTextBlock SourceText="{Binding Text}" TextWrapping="Wrap" FontSize="14"
                                                                    FontFamily="./Assets/Fonts/#Google Sans Flex, Segoe UI Emoji, Microsoft YaHei UI" />
                                            <Image Source="{Binding Thumbnail}" MaxWidth="420" MaxHeight="300" Stretch="Uniform"
                                                   Margin="0,8,0,0" Visibility="{Binding ThumbnailVisibility}" />
                                            <TextBlock Text="{Binding AttachmentLabel}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" />
                                            <Button Content="下载附件" Click="Download_Click" Style="{StaticResource TextButton}" HorizontalAlignment="Left"
                                                    Padding="12,6" Margin="0,6,0,0" Visibility="{Binding DownloadVisibility}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SystemNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource SurfaceContainerBrush}" CornerRadius="10" Padding="12,5" Margin="0,2,0,2">
                                        <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                   TextAlignment="Center" FontFamily="./Assets/Fonts/#Google Sans Flex, Segoe UI Emoji, Microsoft YaHei UI" MaxWidth="640" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True">
                                        <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="SystemNotice" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 成员列表 -->
            <Border x:Name="MemberPanel" Grid.Column="1" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="24" Padding="12" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="房间成员" Style="{StaticResource TitleMedium}" Margin="8,6,8,10" />
                    <ListBox x:Name="MembersList" Background="Transparent" BorderThickness="0"
                             ContextMenuOpening="MembersList_ContextMenuOpening" PreviewMouseRightButtonDown="MembersList_PreviewMouseRightButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="MemberContextMenu">
                                <MenuItem Header="复制用户名" Click="CopyMemberName_Click"/>
                                <MenuItem Header="复制 IP" Click="CopyMemberIp_Click"/>
                                <Separator/>
                                <MenuItem Header="切换禁言" Tag="/mute" Click="MemberCommand_Click"/>
                                <MenuItem Header="踢出" Tag="/kick" Click="MemberCommand_Click"/>
                                <MenuItem Header="封禁用户" Tag="/ban" Click="MemberCommand_Click"/>
                                <MenuItem Header="封禁 IP" Tag="/ipban" Click="MemberCommand_Click"/>
                                <Separator/>
                                <MenuItem Header="艾特 TA" Click="MentionMember_Click"/>
                                <MenuItem x:Name="AdminToggleItem" Header="设为管理员" Click="ToggleAdmin_Click"/>
                                <MenuItem Header="请求远程控制" Click="RequestRemoteControl_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 艾特候选列表 -->
            <Border x:Name="MentionPanel" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="12,0,0,12" Background="{StaticResource SurfaceContainerHighBrush}" BorderBrush="{StaticResource OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="4" Panel.ZIndex="20" MaxHeight="240">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <ListBox x:Name="MentionList" Width="220" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="MentionList_MouseUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="@" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceContainerHighestBrush}" /></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SecondaryContainerBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Grid>

        <!-- ===== 输入区 ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="24" Padding="14" Margin="20,14,20,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <WrapPanel Margin="2,0,0,10">
                    <ToggleButton x:Name="MembersToggle" Content="成员列表" Checked="MembersToggle_Changed" Unchecked="MembersToggle_Changed" Margin="0,0,8,8" />
                    <Button Content="封禁列表" Click="ShowBanList_Click" Style="{StaticResource TonalButton}" Padding="14,8" Margin="0,0,8,8" />
                    <Button x:Name="EmojiButton" Content="😊 表情" Click="Emoji_Click" Style="{StaticResource TonalButton}" Padding="14,8" Margin="0,0,8,8" />
                    <Button x:Name="SendFileButton" Content="发送文件" Click="File_Click" Style="{StaticResource TonalButton}" Padding="14,8" Margin="0,0,8,8" />
                    <Button x:Name="SendImageButton" Content="发送图片" Click="Image_Click" Style="{StaticResource TonalButton}" Padding="14,8" Margin="0,0,8,8" />
                    <Button Content="默认下载位置" Click="DownloadFolder_Click" Style="{StaticResource TextButton}" Padding="12,8" Margin="0,0,8,8" />
                    <ComboBox x:Name="SendShortcutSelector" Width="150" Margin="0,0,8,8" VerticalContentAlignment="Center"
                              SelectionChanged="SendShortcutSelector_SelectionChanged">
                        <ComboBoxItem Content="Ctrl+Enter 发送" Tag="CtrlEnter" />
                        <ComboBoxItem Content="Enter 发送" Tag="Enter" />
                    </ComboBox>
                    <TextBlock Text="指令：/mute、/kick、/ban、/ipban、/unban、/unipban" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,8" />
                </WrapPanel>

                <!-- 上传进度 -->
                <Border x:Name="UploadProgressPanel" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource SurfaceContainerBrush}"
                        CornerRadius="14" Padding="12,9" Margin="2,0,2,10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="UploadProgressText" Text="正在准备上传…" FontSize="12"
                                       Foreground="{StaticResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="UploadProgressPercent" DockPanel.Dock="Right" Text="0%" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                        </DockPanel>
                        <ProgressBar x:Name="UploadProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" />
                    </Grid>
                </Border>

                <!-- 引用条 + 输入框 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Border x:Name="ReplyBar" Grid.Row="0" Visibility="Collapsed" Background="{StaticResource SecondaryContainerBrush}"
                            CornerRadius="12" Padding="14,9" Margin="0,0,0,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource IconButton}" Width="30" Height="30"
                                    FontSize="12" ToolTip="取消引用" PreviewMouseLeftButtonUp="CancelReply_Click" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ReplySenderText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource OnSecondaryContainerBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ReplyPreviewText" FontSize="11" Foreground="{StaticResource OnSecondaryContainerBrush}"
                                           Opacity=".8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RichTextBox x:Name="MessageInput" MinHeight="52" MaxHeight="130" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center"
                                     FontFamily="./Assets/Fonts/#Google Sans Flex, Segoe UI Emoji, Microsoft YaHei UI"
                                     PreviewKeyDown="MessageInput_PreviewKeyDown" TextChanged="MessageInput_TextChanged"
                                     SelectionChanged="MessageInput_SelectionChanged" LostKeyboardFocus="MessageInput_LostKeyboardFocus" />
                        <Button Grid.Column="1" Content="发送" Click="Send_Click" Margin="12,0,0,0" Style="{StaticResource FabButton}" />
                    </Grid>
                </Grid>

                <!-- 内置表情弹层（Google emoji 贴图）：向上弹出，点击外部关闭 -->
                <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiButton}" Placement="Custom"
                       CustomPopupPlacementCallback="EmojiPopup_Placement"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="404" Height="316" Background="{StaticResource SurfaceContainerHighBrush}"
                            BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="18" Padding="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.5" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="2,2,2,8">
                                <StackPanel x:Name="EmojiCategoryBar" Orientation="Horizontal" />
                            </ScrollViewer>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="EmojiItems">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource EmojiCellButton}" Click="EmojiItem_Click" ToolTip="{Binding Name}" Tag="{Binding Emoji}">
                                                <Image Source="{Binding Image}" Width="26" Height="26" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>            </Grid>
        </Border>
    </Grid>
</Window>
