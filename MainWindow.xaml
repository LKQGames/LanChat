<Window x:Class="LanChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="局域聊天室" Width="1160" Height="800" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Foreground="{StaticResource OnSurfaceBrush}"
        FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI">
    <Window.Resources>
        <!-- 操作卡片样式 -->
        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Card" Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="22"
                                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1" />
                            <Border x:Name="Overlay" Background="{StaticResource OnSurfaceBrush}" Opacity="0" CornerRadius="22" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.05" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource OutlineBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Overlay" Property="Opacity" Value="0.10" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                <GradientStop Color="#12151B" Offset="0" />
                <GradientStop Color="#0C0E13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部应用栏 ===== -->
        <Border Grid.Row="0" Background="#14171D" Padding="26,16" BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Border Width="44" Height="44" CornerRadius="14" Background="{StaticResource PrimaryContainerBrush}" Margin="0,0,16,0" DockPanel.Dock="Left">
                    <TextBlock Text="✉" FontSize="20" Foreground="{StaticResource OnPrimaryContainerBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="局域聊天室" Style="{StaticResource TitleLarge}" FontSize="21" />
                    <TextBlock Text="和同一局域网中的朋友轻松交流" Style="{StaticResource BodySmall}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="检查更新" Style="{StaticResource TextButton}" Click="UpdateButton_Click" Margin="0,0,4,0" />
                    <Button x:Name="HelpButton" Content="帮助" Style="{StaticResource TextButton}" Click="HelpButton_Click" Margin="0,0,10,0" />
                    <ToggleButton x:Name="LogToggle" Content="运行日志" Click="LogToggle_Checked" Unchecked="LogToggle_Unchecked" Margin="0,0,8,0" />
                    <ToggleButton Content="置顶" Checked="Pin_Checked" Unchecked="Pin_Unchecked" Margin="0,0,14,0" />
                    <Button x:Name="UsernameButton" Content="输入用户名" Click="UsernameButton_Click" Padding="20,10" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1" Margin="26,22,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧主视觉 -->
            <Border Grid.Column="0" CornerRadius="32" BorderBrush="#1E2A3D" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B2A44" Offset="0" />
                        <GradientStop Color="#151A24" Offset="0.62" />
                        <GradientStop Color="#12151B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="46">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                        <Border Background="#2A3B58" CornerRadius="10" Padding="13,7" HorizontalAlignment="Left" Margin="0,0,0,26">
                            <TextBlock Text="WELCOME" FontSize="10.5" FontWeight="SemiBold" Foreground="#C8DAFF"
                                       FontFamily="./Assets/Fonts/#Google Sans Flex, Microsoft YaHei UI" />
                        </Border>
                        <TextBlock Text="让交流，&#xA;从一个房间开始。" FontSize="44" FontWeight="SemiBold"
                                   LineHeight="54" Foreground="#EAF0FF" />
                        <TextBlock Text="创建一个新聊天室，或找到已有房间继续对话。所有消息通过 AES-256-GCM 端到端加密，局域网直连、不经服务器。"
                                   Style="{StaticResource BodyMedium}" FontSize="14" LineHeight="23" Margin="0,22,0,0" Foreground="#B7C2D6" />

                        <StackPanel Margin="0,34,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="34" Height="34" CornerRadius="12" Background="#233650" Margin="0,0,14,0">
                                    <TextBlock Text="🔒" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="加密传输" FontSize="13" FontWeight="SemiBold" Foreground="#DCE6FA" />
                                    <TextBlock Text="ECDH 协商 + AES-256-GCM" FontSize="11.5" Foreground="#8FA0BC" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="34" Height="34" CornerRadius="12" Background="#233650" Margin="0,0,14,0">
                                    <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="局域网直连" FontSize="13" FontWeight="SemiBold" Foreground="#DCE6FA" />
                                    <TextBlock Text="无需账号，启动即可聊天" FontSize="11.5" Foreground="#8FA0BC" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="12" Background="#233650" Margin="0,0,14,0">
                                    <TextBlock Text="📎" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="文件与图片" FontSize="13" FontWeight="SemiBold" Foreground="#DCE6FA" />
                                    <TextBlock Text="单个附件最大 1 GB" FontSize="11.5" Foreground="#8FA0BC" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Google Sans Flex · Material Design 3" Style="{StaticResource BodySmall}"
                               FontSize="11" Foreground="#64708A" Margin="0,28,0,0" />
                </Grid>
            </Border>

            <!-- 右侧操作区 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="4,4,4,20">
                    <TextBlock Text="开始使用" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                    <TextBlock Text="选择一种方式进入聊天室" Style="{StaticResource BodySmall}" Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Button x:Name="JoinRoomButton" Click="JoinRoom_Click" Style="{StaticResource ActionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="16" Background="#2B4A7C" VerticalAlignment="Center">
                                    <TextBlock Text="↗" FontSize="20" Foreground="#D6E3FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="加入指定聊天室" FontSize="15" FontWeight="SemiBold" Foreground="#EAF0FF" />
                                    <TextBlock Text="输入主机地址与端口" FontSize="12" Foreground="#8FA0BC" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="#8FA0BC" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="SearchRoomButton" Click="SearchRoom_Click" Style="{StaticResource ActionCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="16" Background="#2B3A52" VerticalAlignment="Center">
                                    <TextBlock Text="⌕" FontSize="22" Foreground="#C8DAFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="搜索已创建的聊天室" FontSize="15" FontWeight="SemiBold" Foreground="#EAF0FF" />
                                    <TextBlock Text="浏览当前局域网的公开房间" FontSize="12" Foreground="#8FA0BC" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="#8FA0BC" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="CreateRoomButton" Click="CreateRoom_Click" Style="{StaticResource ActionCard}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="16" Background="#1E3B29" VerticalAlignment="Center">
                                    <TextBlock Text="＋" FontSize="20" Foreground="#A6E9B9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="新建聊天室" FontSize="15" FontWeight="SemiBold" Foreground="#DDF3E3" />
                                    <TextBlock Text="创建房间并邀请其他人" FontSize="12" Foreground="#8FA99A" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="24" Foreground="#8FA99A" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Background="{StaticResource SurfaceContainerLowBrush}" CornerRadius="16" Padding="16,14"
                                BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="每日一言" Style="{StaticResource LabelMedium}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="uapis.cn" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="QuoteText" Text="正在获取每日一言…" Style="{StaticResource BodyMedium}" FontSize="12.5"
                                           LineHeight="20" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== 底部信息 ===== -->
        <DockPanel Grid.Row="2" Margin="30,18,30,16">
            <TextBlock x:Name="VersionText" Text="v1.0.0" Style="{StaticResource BodySmall}" FontSize="11" DockPanel.Dock="Left" />
            <TextBlock Text="Material Design 3 · 局域网聊天室" Style="{StaticResource BodySmall}" FontSize="11" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</Window>
